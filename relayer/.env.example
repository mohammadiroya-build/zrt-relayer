PORT=8787

# Path to the deployment config (contract addresses live there, not in code)
CONFIG_PATH=web/config.json

# The attestor signs packet commitments. The relayer sends transactions.
# Both default to the same key; splitting them is optional.
ATTESTOR_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Faucet hot wallet. Needs ZRT on Zenith and a little ZTH for gas.
# Leave empty to reuse RELAYER_PRIVATE_KEY; set FAUCET_SHARED_KEY=false to forbid that.
TREASURY_PRIVATE_KEY=
FAUCET_SHARED_KEY=true

# Optional overrides
FAUCET_ENABLED=false
FAUCET_AMOUNT=1
FAUCET_COOLDOWN_HOURS=24
# Keep issuing claims when the faucet wallet has no token balance.
FAUCET_MINT_FALLBACK=true
POLL_MS=30000
START_BLOCK_OFFSET=5000
LOOKBACK_BLOCKS=20000
MIN_GAS_NATIVE=0.0005
CORS_ORIGIN=*
DATA_DIR=./data
